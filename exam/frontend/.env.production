# The exam app's API client reads VITE_API_URL (src/api/client.js). Vercel
# rewrites /api/* to the backend (vercel.json), so a relative path is right.
# This file used to set only VITE_EXAM_API_URL, which nothing reads — the
# production build then fell back to http://localhost:3000/api and every exam
# start failed on a student's machine.
VITE_API_URL=/api
VITE_EXAM_API_URL=/api
